# MINI AHRS board V1.4 — ESP32-S31-WROOM-1-N16R16V
#
# Same pinout and software as the V1.5 (esp32s31mini): the only difference is
# the u-blox DAN-F10N GPS on the board, wired to S3 (SERIAL3, IO3/IO4) with
# its TIMEPULSE on IO5 (not used: the ESP32 HAL has no PPS input). The GPS
# settings are in defaults.parm.
include ../esp32s31mini/hwdef.dat

undef HAL_ESP32_BOARD_NAME
define HAL_ESP32_BOARD_NAME "esp32s31mini14"
