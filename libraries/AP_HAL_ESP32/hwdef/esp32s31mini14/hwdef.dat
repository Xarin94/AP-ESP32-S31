# MINI AHRS board V1.4 — ESP32-S31-WROOM-1-N16R16V
#
# SCH16T IMU alone on the first SPI bus; 2x BMP581 on the second. u-blox
# DAN-F10N GPS on the board. PWM outputs SERVO1-8.
#
# Pins from the V1.4 schematic (esp32s31corv/pcb/v1.4 in the CORV tree); the
# module pads 42-53 are not on their schematic GPIO, so UART1, UART2 and the
# LEDs stay on the GPIOs measured on the V1.2, as on the V1.5.
#
# This build is for a V1.4 without RM3100, SD card and ELVH: their parts are
# not mounted and their chip selects are not driven. CAN on the MCP2542FD,
# TX IO57 / RX IO56 as on the V1.5.
#
# Module pins not available (datasheet S31): GPIO26-28/30-32 flash,
# GPIO29/41 not bonded, GPIO33/34 USB Serial/JTAG. Strapping pins: GPIO36/37
# are MOSI/MISO of the second SPI bus, GPIO60/61 are not used.

define HAL_ESP32_BOARD_NAME "esp32s31mini14"

# Dual core layout (HP CPU0 / HP CPU1):
#  core 0: main loop (vehicle code, AHRS/EKF3), timer and UART threads
#  core 1: SPI bus threads (SCH16T at 1 kHz on its bus; baros on the other),
#          Wi-Fi/lwIP, IO, storage, RC and library threads
define HAL_ESP32_FASTCPU 0
define HAL_ESP32_SLOWCPU 1
define HAL_ESP32_DEVICE_BUS_CPU 1
define HAL_ESP32_THREAD_CPU 1

# LP core supervisor of the HP threads, as on the V1.5: when the main loop
# makes no progress for HAL_ESP32_LP_WDT_MS it saves a post-mortem and asks
# for a reboot (BRD_OPTIONS bit 0, on by default here)
define HAL_ESP32_LP_SUPERVISOR 1
define HAL_ESP32_LP_WDT_MS 2000
define HAL_BRD_OPTIONS_DEFAULT 1

# SPI buses: the IMU alone on SPI2, the baros on SPI3
#            Host      DMA Channel     MOSI        MISO        SCLK
ESP32_SPIBUS SPI2_HOST SPI_DMA_CH_AUTO GPIO_NUM_21 GPIO_NUM_22 GPIO_NUM_20
ESP32_SPIBUS SPI3_HOST SPI_DMA_CH_AUTO GPIO_NUM_36 GPIO_NUM_37 GPIO_NUM_35

# SPI Devices (chip selects are driven high by the HAL at boot)
#            Name      Bus Device ChipSel      Mode LoSpeed  HiSpeed
ESP32_SPIDEV sch16t    0   0      GPIO_NUM_25  0    1*MHZ    8*MHZ
ESP32_SPIDEV bmp581_1  1   0      GPIO_NUM_23  0    1*MHZ    1*MHZ
ESP32_SPIDEV bmp581_2  1   1      GPIO_NUM_24  0    1*MHZ    1*MHZ
# not an SPI device: IO2 is RESET_N of the DAN-F10N (GPSrst, active low). No
# driver opens this line, so it takes no slot on the host; it is listed so
# the HAL drives IO2 high at boot and keeps the receiver out of reset
ESP32_SPIDEV gps_rst   1   2      GPIO_NUM_2   0    400*KHZ  400*KHZ

# SCH16T variant mounted on the board (K10 by default):
#   1  = SCH16T-K01, high precision, +-300 deg/s, +-8 g
#   10 = SCH16T-K10, +-2000 deg/s, +-16 g
define HAL_SCH16T_VARIANT 10

# SCH16T: EXTRESN tied to VCC on the V1.4, DRY_SYNC not used (the driver
# reads the interpolated outputs and stamps each sample at the read)
# internal low pass: LPF0, 68 Hz Butterworth 4th order on every axis
define HAL_SCH16T_LPF_CODE 0x000
define HAL_SCH16T_SAMPLE_RATE 1000

# live vibration spectrum of the IMU over MAVLink (INS_FFT_LIVE)
define AP_INERTIALSENSOR_SPECTRUM_ENABLED 1

# sensor axes as on the V1.2 and V1.5: SCH16T x, -y, -z
IMU SCH16T SPI:sch16t ROTATION_ROLL_180
define HAL_INS_DEFAULT HAL_INS_NONE

# no compass on the board (RM3100 not mounted)
define AP_COMPASS_PROBING_ENABLED 0

BARO BMP581 SPI:bmp581_1
BARO BMP581 SPI:bmp581_2
define AP_BARO_BMP581_ENABLED 1

# Serial ports. The HAL maps the entries as
#   [0] -> SERIAL0, [1] -> SERIAL3, [2] -> SERIAL2, [3] -> SERIAL4;
#   SERIAL1 is Wi-Fi.
# RX and TX can be swapped at run time with bit 3 of SERIALn_OPTIONS.
#            PORT             RXPIN        TXPIN
ESP32_SERIAL USB_SERIAL_JTAG  GPIO_NUM_NC  GPIO_NUM_NC
# DAN-F10N: rxgps (IO3) from its TXD, txgps (IO4) to its RXD. Its
# TIMEPULSE is on IO5, not used: the ESP32 HAL has no PPS input
ESP32_SERIAL UART_NUM_1       GPIO_NUM_3   GPIO_NUM_4
# connectors S2 (U7) and S1 (U4): IO10/IO11 and IO8/IO9 as measured on the
# V1.2. The pin marked R (IO10, IO8) is the board RX: it goes to the TX of
# the device
ESP32_SERIAL UART_NUM_2       GPIO_NUM_10  GPIO_NUM_11
ESP32_SERIAL UART_NUM_3       GPIO_NUM_8   GPIO_NUM_9

# time per loop for the GCS on ArduPlane at the 200 Hz loop
define PLANE_GCS_SEND_TIME_US 750

# asks the USB Serial/JTAG not to reset the chip from DTR/RTS (on chip
# revision v0.0 the reset still happens with DTR low and RTS high: open the
# port lowering RTS first)
define HAL_ESP32_USB_NO_CHIP_RESET 1

# MAVLink over Wi-Fi UDP (SERIAL1): access point, 192.168.4.1:14550
define HAL_ESP32_WIFI 2
define WIFI_SSID "ardupilot-s31"
define WIFI_PWD "ardupilot1"

# CAN: TWAI controller on the MCP2542FD transceiver (DroneCAN), same pins
# as on the V1.5
#         TXPIN        RXPIN
ESP32_CAN GPIO_NUM_57  GPIO_NUM_56
# SLCAN on demand, as on the STM32 boards with one USB port: with
# CAN_SLCAN_CPORT 1 (at boot) and CAN_SLCAN_SERNUM 0 the USB (SERIAL0) turns
# into an SLCAN adapter on CAN1 until CAN_SLCAN_TIMOUT or a reboot. The S31
# has no second USB CDC: the USB connector is the USB Serial/JTAG
define AP_CAN_SLCAN_ENABLED 1

# PWM outputs SERVO1-8 (MCPWM) on s1-s8: pairs 1-2, 3-4, 5-6, 7-8 share one
# timer, so one frequency
ESP32_RCOUT GPIO_NUM_42
ESP32_RCOUT GPIO_NUM_43
ESP32_RCOUT GPIO_NUM_44
ESP32_RCOUT GPIO_NUM_45
ESP32_RCOUT GPIO_NUM_46
ESP32_RCOUT GPIO_NUM_47
ESP32_RCOUT GPIO_NUM_48
ESP32_RCOUT GPIO_NUM_49

# no RC input pin: RC comes from a serial protocol (CRSF/ELRS/SBUS)

# status LEDs, active high: LED1 start-up, LED2 GPS fix and position, on IO13
# and IO12 as measured on the V1.2. LED3 is not driven
define AP_NOTIFY_GPIO_LED_INIT_GPS_ENABLED 1
define HAL_GPIO_A_LED_PIN 13
define HAL_GPIO_B_LED_PIN 12
define HAL_GPIO_LED_ON 1

# no SD card mounted: no logging, filesystem or scripting
define HAL_LOGGING_ENABLED 0
define AP_FILESYSTEM_ESP32_ENABLED 0
define AP_SCRIPTING_ENABLED 0
