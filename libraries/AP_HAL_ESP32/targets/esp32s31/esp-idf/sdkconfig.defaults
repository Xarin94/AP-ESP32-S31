# ESP32-S31-WROOM-1-N16R16V, ESP-IDF >= 6.1 (esp32s31 is a preview target)
CONFIG_IDF_TARGET="esp32s31"

#
# Bootloader config
#
CONFIG_BOOTLOADER_LOG_LEVEL_ERROR=y
CONFIG_BOOTLOADER_WDT_ENABLE=n

#
# Application manager
#
CONFIG_APP_COMPILE_TIME_DATE=n
CONFIG_APP_EXCLUDE_PROJECT_VER_VAR=y
CONFIG_APP_EXCLUDE_PROJECT_NAME_VAR=y
CONFIG_APP_RETRIEVE_LEN_ELF_SHA=16

#
# Serial flasher config: 16 MB flash on the module, read in QIO: the code
# runs from flash through a 16 kB instruction cache, and a miss costs half
# the time of DIO
#
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

#
# Partition Table
#
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000

#
# Compiler options
#
CONFIG_COMPILER_OPTIMIZATION_PERF=y

#
# Drivers: keep the sensor and CAN paths out of the flash cache
#
CONFIG_FREERTOS_IN_IRAM=y
CONFIG_SPI_MASTER_IN_IRAM=y
CONFIG_SPI_MASTER_ISR_IN_IRAM=y
CONFIG_TWAI_ISR_IN_IRAM=y

#
# HP cores at full speed
#
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_320=y

#
# ESP-IDF console on the USB Serial/JTAG port (UART0 is not routed on the
# board): the start-up and HAL messages share SERIAL0 with MAVLink, through
# the same driver once SERIAL0 is opened.
#
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

#
# Watchdogs: ArduPilot runs its own task watchdog on the main core
#
CONFIG_ESP_INT_WDT=n
CONFIG_ESP_TASK_WDT_INIT=n
CONFIG_ESP_IPC_TASK_STACK_SIZE=1536

#
# Wi-Fi (MAVLink over UDP/TCP)
#
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_1=y
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n
CONFIG_ESP_WIFI_GMAC_SUPPORT=n

#
# FreeRTOS
#
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_THREAD_LOCAL_STORAGE_POINTERS=10
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_ISR_STACKSIZE=2100

#
# LWIP
#
CONFIG_LWIP_MAX_SOCKETS=5
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5744
CONFIG_LWIP_TCP_WND_DEFAULT=5744
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU1=y

#
# The 16 MB PSRAM is left disabled: code and data stay in internal SRAM
#
CONFIG_SPIRAM=n

#
# C library: ArduPilot is compiled by waf against the newlib headers
#
CONFIG_LIBC_NEWLIB=y
