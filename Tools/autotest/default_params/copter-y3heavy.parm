# Y3Heavy: tricopter, two Hobbywing X6 Plus G2 (MFP 24x8) in front,
# 350KV 13x10x3 on a +-60 deg tilt servo at the rear, 12S.
# Split mixer: roll and throttle on the front pair, pitch on the rear
# motor, yaw on the tail servo. Physics: SITL model y3heavy (SIM_Y3_*)

FRAME_CLASS     7
MOT_TRI_MIX     1
# rear thrust in hover, same scale as MOT_THST_HOVER. The model needs
# 0.212: start about 30% low and let MOT_TRI_RH_LEARN find it in hover
MOT_TRI_RHOV    0.15
MOT_TRI_RH_LEARN 2

# tail servo
MOT_YAW_SV_ANGLE 60
SERVO7_MIN      1000
SERVO7_MAX      2000
SERVO7_TRIM     1500

# X6 Plus G2 ESC: fixed 1050-1950 us range, no calibration. The rear
# ESC is calibrated to the same range. Thrust curve fitted on the
# Hobbywing 12S table: linear above SPIN_MIN
MOT_PWM_MIN     1050
MOT_PWM_MAX     1950
MOT_SPIN_ARM    0.15
MOT_SPIN_MIN    0.22
MOT_SPIN_MAX    0.95
MOT_THST_EXPO   0.0
MOT_THST_HOVER  0.2
MOT_HOVER_LEARN 2
# the X6 ESC holds speed, so no voltage compensation
MOT_BAT_VOLT_MAX 0

# 12S pack
SIM_BATT_VOLTAGE 50.4
BATT_CAPACITY   16000

# rate and angle gains from y3heavy_pid_design.py (rear 10% of the
# weight, X6 lag 0.07 s, rear 0.035 s, servo 0.025 s): phase margin 50 deg
# nominal, at least 38 deg with actuators twice as slow.
# Tools/autotest/y3heavy/ has the 15% and the first-flight sets
ATC_RAT_RLL_P   0.142
ATC_RAT_RLL_I   0.142
ATC_RAT_RLL_D   0.0057
ATC_RAT_PIT_P   0.551
ATC_RAT_PIT_I   0.551
ATC_RAT_PIT_D   0.0152
ATC_RAT_YAW_P   0.79
ATC_RAT_YAW_I   0.079
ATC_RAT_YAW_D   0
ATC_RAT_YAW_FLTE 5.0
ATC_ANG_RLL_P   6.5
ATC_ANG_PIT_P   9
ATC_ANG_YAW_P   3
# acceleration limits, deg/s/s. Pitch: about half the nose down authority
# with 6 kg (the rear motor can only drop from hover to idle); yaw: about
# a third of the maximum
ATC_ACC_R_MAX 600
ATC_ACC_P_MAX 200
ATC_ACC_Y_MAX 200
