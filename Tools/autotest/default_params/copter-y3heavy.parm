# Y3Heavy: tricopter, two Hobbywing X6 Plus G2 (MFP 24x8) in front,
# 350KV 13x10x3 on a +-60 deg tilt servo at the rear, 12S.
# Split mixer: roll and throttle on the front pair, pitch on the rear
# motor, yaw on the tail servo. Physics: SITL model y3heavy (SIM_Y3_*)

FRAME_CLASS     7
MOT_TRI_MIX     1
# rear thrust in hover, same scale as MOT_THST_HOVER
MOT_TRI_RHOV    0.21

# tail servo
MOT_YAW_SV_ANGLE 60
SERVO7_MIN      1000
SERVO7_MAX      2000
SERVO7_TRIM     1500

# X6 Plus G2 ESC: fixed 1050-1950 us range, no calibration. The rear
# ESC is calibrated to the same range. Thrust curve fitted on the
# Hobbywing 12S table: linear above SPIN_MIN
MOT_PWM_MIN     1050
MOT_PWM_MAX     1950
MOT_SPIN_ARM    0.15
MOT_SPIN_MIN    0.22
MOT_SPIN_MAX    0.95
MOT_THST_EXPO   0.0
MOT_THST_HOVER  0.2
MOT_HOVER_LEARN 2
# the X6 ESC holds speed, so no voltage compensation
MOT_BAT_VOLT_MAX 0

# 12S pack
SIM_BATT_VOLTAGE 50.4
BATT_CAPACITY   16000

# first rate gains, from the model's control authority and rotor time
# constants: roll on the slow front pair, pitch on the fast rear motor
ATC_RAT_RLL_P   0.035
ATC_RAT_RLL_I   0.035
ATC_RAT_RLL_D   0.003
ATC_RAT_PIT_P   0.18
ATC_RAT_PIT_I   0.18
ATC_RAT_PIT_D   0.006
ATC_RAT_YAW_P   0.25
ATC_RAT_YAW_I   0.025
ATC_RAT_YAW_FLTE 5.0
ATC_ANG_RLL_P   3.0
# nose down authority is what the rear motor drops from hover to idle
ATC_ACCEL_R_MAX 40000
ATC_ACCEL_P_MAX 30000
ATC_ACCEL_Y_MAX 18000
